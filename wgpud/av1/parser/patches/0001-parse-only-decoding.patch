@@ -0,0 +1,53 @@
+/*
+ * WebGPU Player parser hooks.
+ *
+ * The WebGPU Player engine's AV1 decoder package runs libaom's decoder as a
+ * parser: its parse-only pass reads every frame, and the package's compute
+ * shaders reconstruct and filter. The patched decoder calls these hooks where
+ * its reconstruction, filtering, and frame buffer writes used to run; the
+ * parser bridge in the engine's wgpud/av1/parser/ implements them.
+ */
+
+#ifndef AOM_AV1_DECODER_PARSER_HOOKS_H_
+#define AOM_AV1_DECODER_PARSER_HOOKS_H_
+
+#include "av1/decoder/decoder.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// An intra transform block of the block in dcb->xd.mi[0], in decode order,
+// whether or not it has coefficients. Its coefficients are at the coding
+// block's current offsets, and the hook clears them.
+void av1_parser_intra_transform_block(const AV1_COMMON *cm,
+                                      DecoderCodingBlock *dcb, aom_reader *r,
+                                      int plane, int row, int col,
+                                      TX_SIZE tx_size);
+
+// A transform block of an inter or IntraBC block that is not skipped: a leaf
+// of its transform partition, in decode order, whether or not it has
+// coefficients. The hook clears its coefficients.
+void av1_parser_inter_transform_block(const AV1_COMMON *cm,
+                                      DecoderCodingBlock *dcb, aom_reader *r,
+                                      int plane, int row, int col,
+                                      TX_SIZE tx_size);
+
+// A coding block whose mode info, palette, transform sizes, and coefficients
+// were read.
+void av1_parser_block_parsed(AV1Decoder *pbi, ThreadData *td, int mi_row,
+                             int mi_col, BLOCK_SIZE bsize);
+
+// The frame's last tile group was parsed. The reference map still holds the
+// frames this frame predicts from; the refresh follows.
+void av1_parser_frame_parsed(AV1Decoder *pbi);
+
+// A reference the bitstream lost, which error resilient mode replaces with a
+// frame of neutral grey.
+void av1_parser_missing_reference(AV1Decoder *pbi, RefCntBuffer *buffer);
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+
+#endif  // AOM_AV1_DECODER_PARSER_HOOKS_H_
