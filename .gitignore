node_modules/
coverage/
__pycache__/

# Build outputs, including the decoder builds in bin/wasm/ and the local playback media in bin/playback_smoke_media/
/bin/*
# The generated codec vector assets are committed, so every change to them shows in review
!/bin/codec_vector_assets/

# Build trees and the Rust target directories of the engine's WebAssembly and of the decoder projects
wasm/build/
wasm/libdovi/target/
/decoders/build/
/decoders/*/*/target/

# The built book; .github/workflows/docs.yml builds and publishes it
/docs/book/

# A Vite build of the sandbox, which only ever runs locally
/sandbox/dist/
