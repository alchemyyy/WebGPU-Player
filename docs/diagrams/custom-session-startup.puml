@startuml
!include diagram-theme.puml
skinparam sequenceMessageAlign left

box "Host" $BOX_HOST
participant "Host player" as host
end box
box "Main thread (engine)" $BOX_MAIN
participant "WebGPUPresenter" as presenter
participant "CustomPlaybackController" as controller
participant "CustomDecodeSession" as session
participant "Audio output" as audio
end box
box "Workers (engine)" $BOX_WORKER
participant "CustomDecode.worker" as worker
participant "CustomAudioDecode.worker" as audioWorker
end box

host -> audio : prewarmBrowserAudioContext(48000)\ninside the user-activation window
host -> presenter : startSession
host -> host : getCustomPlaybackEligibility,\nonce the needed route keys settle
note right of host
  The host's setup bound ends where
  the controller starts.
end note
host -> presenter : push mode on a source-less video element;\ninstall shaders, authorize the selected route
host -> controller : play
activate controller
controller -> controller : new generation, reset clock,\nemit 'waiting', start the startup bound
note right of controller
  Fails after 20 s without decode progress,
  or at 60 s regardless; the fallback message
  names the counters it reached.
end note
controller -> session : start
session -> worker : the first start creates CustomDecode.worker.js?v=<build key>
session -> worker : 'start', once the previous run stopped;\ncredits: 4 frames, or 2 raw-plane buffers
worker -> audioWorker : the first decoded PCM start\ncreates CustomAudioDecode.worker.js
worker -> worker : prepare tracks (canDecode);\nscan static HDR metadata\n(first 16 access units or 8 MiB)
worker --> session : 'ready'
par video
  worker --> session : 'frame' (credit-limited)
else decoded PCM
  worker -> audioWorker : open the attempt; packet or sample\nbatches, 4 in flight
  session -> worker : 'attach-audio-output': the worklet's channel
  worker -> audioWorker : the worklet's channel
  audioWorker --> audio : PCM chunks over that channel (8 credits)
  audioWorker --> worker : progress
  worker --> session : 'audio-progress'
else native-media audio
  worker --> audio : fMP4 segments
end
session -> controller : first frame queued, and 100 ms of PCM submitted\n(or the first native-media segment appended)
controller -> audio : start
controller -> controller : resume the clock
controller --> host : 'ready', 'playing'
deactivate controller
host -> host : start the rAF loop
@enduml
