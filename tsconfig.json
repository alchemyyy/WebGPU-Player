{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["@webgpu/types", "node"],
    "baseUrl": ".",
    "paths": {
      "mediabunny": ["vendor/mediabunny"],
      "webgpu-player/*": ["src/*"]
    }
  },
  "include": ["src", "test", "wgpud/*/test", "sandbox/src"]
}
